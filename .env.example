# Completar SOLO aquí, nunca commitear .env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

REDIS_URL=redis://redis:6379/0
REDIS_STREAM=intelligence:jobs
REDIS_GROUP=intelligence-workers

VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=technical_knowledge
# Para reutilizar el índice de la Pre-entrega 4, configurar backend pinecone,
# índice con dimensión coincidente y credenciales:
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=technical-docs
RAG_TOP_K=5
SEMANTIC_WEIGHT=0.65
LEXICAL_WEIGHT=0.35
CHUNK_SIZE=900
CHUNK_OVERLAP=130
RAG_AUTO_INGEST=true

WORKER_CONCURRENCY=5
API_KEY=
APPROVAL_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coderhouse-final-intelligence
